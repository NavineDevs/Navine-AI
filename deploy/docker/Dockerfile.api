FROM python:3.12-slim-bookworm AS api

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt || pip install --no-cache-dir torch fastapi uvicorn pyyaml pillow tqdm torchvision

COPY . .
ENV PYTHONPATH=/app
EXPOSE 8765
CMD ["python", "-m", "navine.server"]

