{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Navine AI",
  "version": "0.1.0",
  "identifier": "ai.navine.desktop",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Navine AI",
        "width": 1100,
        "height": 780,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "url": "http://127.0.0.1:8765"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
